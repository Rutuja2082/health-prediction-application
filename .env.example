# Copy this file to ".env" and fill in your own key. Never commit ".env".
# AI_PROVIDER: gemini | openai_compatible (Groq, OpenAI, etc.) | none (rule-based only)
AI_PROVIDER=gemini
AI_API_KEY=your_api_key_here
AI_MODEL=gemini-3.5-flash-lite
# Only used for openai_compatible, e.g. https://api.groq.com/openai/v1
AI_BASE_URL=
